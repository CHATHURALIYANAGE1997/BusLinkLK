# Local overrides for infra/docker-compose.yml
#
# Copy to infra/.env and change only what you need:
#   cp infra/.env.example infra/.env        (Windows: copy infra\.env.example infra\.env)
# infra/.env is git-ignored. Everything below already has a default in
# docker-compose.yml, so the file is optional.
#
# These are LOCAL DEVELOPMENT values only. Never put real/cloud credentials here.

COMPOSE_PROJECT_NAME=buslink

# --- Image versions ---------------------------------------------------------
KAFKA_VERSION=4.3.1
SCHEMA_REGISTRY_VERSION=8.3.2
KAFKA_UI_VERSION=v1.5.0
POSTGIS_VERSION=17-3.5
REDIS_VERSION=8.10-alpine

# --- Host ports (change if something on your machine already uses one) ------
KAFKA_HOST_PORT=9092
SCHEMA_REGISTRY_HOST_PORT=8091
KAFKA_UI_HOST_PORT=8089
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- PostgreSQL -------------------------------------------------------------
# Admin account (used only by the init script and for manual inspection)
POSTGRES_ADMIN_USER=buslink
POSTGRES_ADMIN_PASSWORD=buslink
# One owner per service database (database name = role name)
ROUTE_DB_PASSWORD=route
FARE_DB_PASSWORD=fare
WALLET_DB_PASSWORD=wallet
ANALYTICS_DB_PASSWORD=analytics

# --- Kafka ------------------------------------------------------------------
# KRaft cluster id (22-char base64 UUID). Only change it together with `down -v`.
KAFKA_CLUSTER_ID=XxPagFSwTb6mmoTEjKUTLw
